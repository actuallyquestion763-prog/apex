node_modules/
dist/

# Env files: ignore every .env* variant except the checked-in placeholder
# templates. Order matters — negations must come after the broad pattern.
# .env.staging (filled in) is ignored; .env.staging.example (template,
# Phase 5 Part 26) is committed, same pattern as .env.example.
.env
.env.*
!.env.example
!.env.staging.example

# Local/ephemeral PostgreSQL data directories (real database files — the
# persistent dev instance and the disposable e2e-test instance). Never
# commit these; they are how the local database physically exists on disk.
.pgdata-dev/
.pgdata-test/

# Legacy local-disk upload directory (P1-A: media-storage.service.ts is now
# S3-backed — see S3_* env vars — and no longer writes here). Left ignored
# harmlessly in case a pre-P1-A checkout still has one on disk locally.
uploads/

# P1-A: real local S3-compatible test server data (scripts/test-s3.js, via
# the s3rver package) — ephemeral, test-only, never committed.
.s3rver-test/

# Local S3-compatible dev server data (scripts/dev-s3.js) — persistent local
# dev uploads (QR codes, CMS media, KYC docs, etc.), never committed.
.s3rver-dev/

# Backup/restore drill artifact (Phase 5, Part 29 — scripts/backup-restore-drill.ts
# removes this itself on a normal run; ignored as a safety net for an
# interrupted run). Never a real backup of trust_dev.
.backup-drill.json

# Database dumps / exports / local db files. Deliberately NOT a bare
# "*.sql" rule — that would also match backend/prisma/migrations/**/*.sql,
# which MUST be committed. These patterns only match dump-shaped filenames.
*.dump
*.sqlite
*.sqlite3
*.db
dump.sql
*.dump.sql

coverage/
*.log
*.tsbuildinfo

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
