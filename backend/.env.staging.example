# TRUST backend — STAGING environment configuration template (Phase 5, Part 26)
#
# Staging is a separate environment from development AND production: its
# own database, its own secrets, its own storage. It exists to test real
# deployment configuration (HTTPS origin, production-shaped cookies/CORS,
# production-shaped validation — see src/config/env.validation.ts) against
# realistic infrastructure BEFORE anything touches production, using only
# test/synthetic data. It must never contain real customer data or be
# pointed at a real payment/execution provider's LIVE credentials — use
# that provider's sandbox/test mode if one exists.
#
# Copy this file to .env.staging (gitignored) and fill in real staging
# values. Never commit a filled-in copy of this file.

NODE_ENV=staging

# A dedicated staging database — never the same instance/credentials as
# development (trust_dev) or production. See src/config/env.validation.ts:
# staging is validated exactly as strictly as production (rejects a
# localhost/trust_dev-shaped URL, rejects a placeholder SESSION_SECRET,
# rejects a missing/localhost/non-https FRONTEND_ORIGIN).
DATABASE_URL="postgresql://trust_app:REPLACE_WITH_A_REAL_STAGING_PASSWORD@REPLACE_WITH_STAGING_DB_HOST:5432/trust_staging?schema=public"

PORT=4100

# Must be the real, HTTPS staging frontend origin — env.validation.ts
# refuses to boot otherwise.
FRONTEND_ORIGIN=https://staging.REPLACE_WITH_YOUR_DOMAIN.example

# Generate independently from both dev's and prod's — never reuse across
# environments. openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_STAGING_ONLY_SECRET

SESSION_TTL_HOURS=24

# Leave unset to exercise the "market data unavailable" path safely, same
# as development — staging should not need a real market-data API key
# unless specifically testing that integration.
MARKET_API_KEY=

# ---------------------------------------------------------------------------
# When a payment/execution provider is eventually integrated (see Part
# 12/13/14 of the Phase 5 report — NOT built yet), staging must point at
# that provider's SANDBOX/TEST mode credentials, never live ones:
#   PAYMENT_PROVIDER_MODE=sandbox
#   PAYMENT_PROVIDER_API_KEY=REPLACE_WITH_SANDBOX_KEY
#   PAYMENT_PROVIDER_WEBHOOK_SECRET=REPLACE_WITH_SANDBOX_WEBHOOK_SECRET
# ---------------------------------------------------------------------------

# There is no seeded/default admin credential in any environment. Create
# staging's first SUPER_ADMIN the same way as any other environment:
#   npm run admin:create-superadmin
