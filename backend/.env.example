# TRUST backend — environment configuration
#
# IMPORTANT: this backend is a FOUNDATION ONLY. It is not connected to a real
# payment provider, broker/exchange, or KYC provider. Nothing here should be
# treated as production-ready or used with real customer funds.
#
# NODE_ENV controls which environment this process considers itself to be in.
# Keep development, staging, and production entirely separate: separate
# databases, separate secrets, separate credentials. Never point a
# development process at a production DATABASE_URL or SESSION_SECRET.
NODE_ENV=development

# Postgres connection string. Each environment (dev/staging/prod) MUST use
# its own database — never share one across environments.
# Example for local Docker Postgres:
#   docker run --name trust-postgres -e POSTGRES_PASSWORD=devpassword -e POSTGRES_DB=trust_dev -p 5432:5432 -d postgres:16
#
# IMPORTANT: this should point at the restricted `trust_app` role (created by
# prisma/migrations/20260816085512_audit_log_immutability), not the Postgres
# superuser — trust_app can read/write everything except UPDATE/DELETE on
# AuditLog. Run `prisma migrate deploy` separately as the superuser; the app
# itself should never connect with superuser credentials. See backend/README.md.
DATABASE_URL="postgresql://trust_app:CHANGE_ME_PER_ENVIRONMENT@localhost:5432/trust_dev?schema=public"

# Backend HTTP port
PORT=4100

# Frontend origin allowed to call this API with credentials (cookies)
FRONTEND_ORIGIN=http://localhost:5173

# Session cookie signing/hashing secret. Generate a long random value per
# environment — never reuse the same secret across dev/staging/prod, and
# never commit a real value. Example generation: openssl rand -hex 32
SESSION_SECRET=REPLACE_WITH_A_LONG_RANDOM_DEV_ONLY_SECRET

# Session lifetime in hours
SESSION_TTL_HOURS=24

# GoldAPI key — same key used by the existing server/market.js proxy.
# This backend re-implements that proxy server-side; the key must never be
# sent to the frontend. Leave unset locally to exercise the "unavailable"
# market-data path safely.
MARKET_API_KEY=

# There is no seeded/default admin credential of any kind, in any
# environment. After running `npm run seed` (permissions/settings/markets
# only) and starting the API, create your first SUPER_ADMIN with:
#   npm run admin:create-superadmin
# This is an interactive-only prompt — it never reads a password from this
# file, any other env var, or a CLI argument, and the password is never
# echoed to the terminal or written anywhere except as an Argon2 hash in the
# database. See backend/scripts/create-superadmin.ts.
