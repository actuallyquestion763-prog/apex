# Example environment variables for the LEGACY standalone market proxy
# (server/market.js) only — kept for now but no longer used by the frontend,
# which talks to the real backend (backend/) instead. See backend/.env.example
# for the backend's environment variables (DATABASE_URL, SESSION_SECRET,
# MARKET_API_KEY, etc.) — that is the one that matters going forward.
# Do NOT commit your real API key. Replace with your own when running the market server.
MARKET_API_KEY=YOUR_GOLDAPI_KEY_HERE
# Optional: market server port (default 4001)
# MARKET_PORT=4001

# There is no frontend-side admin credential of any kind. The Super Admin
# account is created via `npm run admin:create-superadmin` in backend/ — see
# backend/README.md. Do not add a VITE_*-prefixed password variable here; any
# VITE_ env var is bundled into the built JS and shipped to every browser.
